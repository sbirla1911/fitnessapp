# --- Gemini (server-side only) ---
# Get a key at https://aistudio.google.com/apikey (starts with "AIza").
GEMINI_API_KEY=AIza-your-key-here

# --- Supabase (server-side only; SERVICE ROLE key — never expose to the browser) ---
# From your Supabase project: Settings -> API.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Rate limiting ---
# Random secret used to salt IP hashes (generate any long random string).
RATE_LIMIT_SALT=change-me-to-a-long-random-string
# Max plan generations per IP per day, and across all users per day.
RATE_LIMIT_PER_IP_PER_DAY=5
RATE_LIMIT_GLOBAL_PER_DAY=200
